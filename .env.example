# Project URL and keys from Supabase > Settings > API.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-or-anon-key
# Server only. Never prefix this with NEXT_PUBLIC_ or expose it in the browser.
SUPABASE_SERVICE_ROLE_KEY=your-secret-or-service-role-key

# Email of a Supabase Auth user allowed to use /admin.
ADMIN_EMAIL=you@example.com

# On Vercel, the trusted IP header is detected automatically.
# Other hosts: set to "forwarded" ONLY behind a proxy that replaces
# X-Forwarded-For with the actual client IP and prevents direct access.
# TRUSTED_PROXY=forwarded
